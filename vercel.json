{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/panel-rrss", "destination": "/rrss", "permanent": false },
    { "source": "/panel-scribeclaro", "destination": "/estrategia", "permanent": false },
    { "source": "/panel", "destination": "/estrategia", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
